# Mini Operations ERP — environment configuration
# Copy to .env and adjust. NEVER commit real secrets.

# ---------- Backend ----------
SERVER_PORT=8081

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mini_erp_dev
# On macOS Homebrew PostgreSQL your superuser is usually your login name:
DB_USER=divya
DB_PASSWORD=

# MUST be overridden in production; min 32 bytes. Dev default exists only so
# the sample boots out of the box.
JWT_SECRET=change-me-to-a-long-random-string-min-32-bytes!!
JWT_EXPIRATION_MINUTES=480

# ---------- Frontend ----------
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8081

# ---------- Integration tests (backend) ----------
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=mini_erp_test
TEST_DB_USER=divya
TEST_DB_PASSWORD=
